# Copy to backend/.env for local development. That file is gitignored and must
# never be committed. A hosted deploy reads these from the host's environment
# panel rather than from a file.

# --- Server -------------------------------------------------------------
# Port the API listens on. Optional; defaults to 5001.
PORT=5001

# "production" starts the keep-alive cron. Optional; defaults to "development".
NODE_ENV=development

# Neon Postgres connection string. REQUIRED — the server will not boot without it.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Public URL of THIS backend. Only read by the keep-alive cron in production.
API_URL=

# --- Auth (required from ticket 03 onward) ------------------------------
# REQUIRED, both of them. Generate each independently:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Minimum 32 characters. The server refuses to boot when either is missing or
# short, and refuses to boot if the two hold the same value.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes in the jsonwebtoken/`ms` format.
# Optional; default to 60m and 30d respectively.
ACCESS_TOKEN_TTL=60m
REFRESH_TOKEN_TTL=30d

# --- Cutover ------------------------------------------------------------
# While exactly "true", a request with NO token is treated as a manager on
# LEGACY_SHOP_ID, so the pre-auth frontend keeps working. Anything else —
# including unset — disables the bypass. Removed entirely in ticket 12.
LEGACY_UNAUTH=false

# Shop the legacy bypass acts on. Optional; defaults to 1.
LEGACY_SHOP_ID=1

# --- Audit retention (ticket 05) ----------------------------------------
# How many days an audit event is kept. UNSET means the sweep never runs and
# the log grows forever, which is the default on purpose: deleting history is
# something you choose, not something that happens because nobody configured it.
# 548 is 18 months, the recommended value. The sweep runs at 03:00 daily, in
# production only, and deletes at most 5000 rows per run — so a large backlog
# converges over a few days rather than in one long-locking statement.
AUDIT_RETENTION_DAYS=

# --- One-time super admin seed (ticket 03) ------------------------------
# Optional. Consumed once, only when the users table is empty, and the account
# is created with must_change_password=TRUE. Choose a NEW password — never the
# old shared VITE_ADMIN_PASSWORD, which every production bundle has exposed.
# Unset both after the first successful boot.
SEED_SUPERADMIN_USERNAME=
SEED_SUPERADMIN_PASSWORD=
