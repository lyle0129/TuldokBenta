VITE_API_URL=http://localhost:5001/api

# There is deliberately no admin password here any more. The client-side gate it
# fed was removed in ticket 07; sign-in is now POST /api/auth/login against a real
# account. Any value you previously set for VITE_ADMIN_PASSWORD was inlined
# verbatim into the production bundle by Vite and has been served in plain text to
# everyone who ever loaded the app — treat it as public and never reuse it as a
# real account's password.
