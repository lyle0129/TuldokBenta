VITE_API_URL=http://localhost:5001/api
# DEPRECATED — removed in ticket 07, when the real login replaces the gate.
# VITE_-prefixed variables are inlined verbatim into the production bundle by
# Vite, so this password has been served in plain text to everyone who has ever
# loaded the app. Treat whatever value you set here as public: it must never be
# reused as the password of a real account.
VITE_ADMIN_PASSWORD=abc123
